Modules\Forever\SessionCheck.lua
# Beta "world will refresh" notice: countdown, warnings, log. No tab.
Modules\Forever\WorldRefresh.lua
# In-game self-test: /ta test, /tatest, or the Self-test title-bar button. Loads last.
Modules\Infrastructure\TestHarness.lua
